PORT=3001
CLIENT_URL=http://localhost:3000
MONGOOSE_URI=your-mongodb-connection-string

JWT_SECRET=your-jwt-secret
JWT_EXPIRY=15m
REFRESH_SECRET=your-refresh-secret
REFRESH_EXPIRY=7d

# Gmail account that sends OTP emails (use a Gmail App Password).
# Leave empty in local development: OTPs are then printed to the server console.
EMAIL=
EMAIL_PASS=
# Admin login email (defaults to EMAIL)
ADMIN_EMAIL=

# Razorpay test keys: Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenAI key for the movie assistant (optional; the assistant is disabled without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
